# --- Writes ---
# Mutating tools need this + confirm:true on each call
S1914_MCP_WRITES=0

# --- Auto-login (optional; otherwise log in once in Playwright window) ---
# Site login box wants in-game PLAYER NAME (not email). Prefer S1914_USERNAME.
S1914_USERNAME=
S1914_EMAIL=
S1914_PASSWORD=
# S1914_LOGIN_URL=https://www.supremacy1914.com/
# S1914_GAME_URL=https://www.supremacy1914.com/game.php

# --- Browser ---
# S1914_CDP_URL=http://127.0.0.1:9222
# S1914_MCP_PROFILE=
# S1914_MCP_HEADLESS=0
# S1914_KEEP_MS=15000

# --- HTTP (ChatGPT / remote agents) ---
# npm run start:http
S1914_MCP_HTTP_PORT=8787
S1914_MCP_HTTP_HOST=127.0.0.1
# Required for remote / production: long random token (openssl rand -hex 32)
S1914_MCP_TOKEN=
# Public URL (OpenAPI servers[]) — set when tunneling
# S1914_PUBLIC_BASE_URL=https://mcp.example.com
# Fail closed without token
# S1914_MCP_REQUIRE_TOKEN=1

# --- Map screenshots (expiring public PNG links) ---
# S1914_SHOT_DIR=./data/shots
# S1914_SHOT_TTL_SEC=900
# S1914_SHOT_MAX=40

# ensure_ready / open_game wait budget (ms). Keep < ChatGPT MCP timeout (~60s).
# S1914_READY_TIMEOUT_MS=22000
# Reject a tool that waits longer than this behind another call (ms).
# S1914_QUEUE_WAIT_MS=8000
# In-memory TTL for heavy reads (ms). 0 disables.
# S1914_READ_CACHE_MS=10000
# Campaign autosnap interval (ms). 0 disables.
# S1914_HISTORY_MS=480000
# S1914_HISTORY_DIR=./data/history

# Optional default for smoke/probe scripts
# S1914_SMOKE_GAME_ID=
# S1914_GAME_ID=
