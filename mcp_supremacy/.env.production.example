# === Production secrets (copy to .env.production — never commit) ===

# REQUIRED — long random string
#   openssl rand -hex 32
S1914_MCP_TOKEN=

# Public URL used in OpenAPI servers[] and screenshot links
# Local:  http://127.0.0.1:8789
# Tunnel: https://mcp.example.com
S1914_PUBLIC_BASE_URL=http://127.0.0.1:8789

# Game login (auto-login) — use in-game PLAYER NAME (login box is not email)
S1914_USERNAME=
S1914_EMAIL=
S1914_PASSWORD=
# S1914_GAME_URL=https://www.supremacy1914.com/game.php

# Writes: leave 0 until you trust remote agents
S1914_MCP_WRITES=0

# Fail closed if token missing (HTTP server)
S1914_MCP_REQUIRE_TOKEN=1

# Optional smoke / probe default (your joined map id from list_games)
# S1914_SMOKE_GAME_ID=
