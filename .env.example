# Copy to .env — fill from a live game session (never commit real secrets).
#
# HOW TO GET GAME KEYS:
#   1. Open the game (logged in)
#   2. DevTools → Console on the PARENT page (game.php), not the iframe
#   3. Paste src/examples/browser-console.js → Enter (see "s1914 ready")
#   4. Run:  s1914.exportSession({secrets:true})
#   5. Map fields below (or: copy(s1914.exportSession({secrets:true})))
#
# Re-export when HTTP auth fails (userAuth/tstamp go stale).
# Optional S1914_COOKIE=bl_sid=... only if POSTs need a site session cookie.
#
# --- AI cabinet (feat/ai-cabinet) ---
# Boot order: (1) game tab + paste bridge (2) npm run cabinet (3) Telegram
# Never commit NVIDIA_API_KEY or TELEGRAM_BOT_TOKEN. Rotate if pasted in chat.

S1914_GAME_SERVER_URI=
S1914_CLIENT=s1914-client-ultimate
S1914_CLIENT_VERSION=293

S1914_GAME_ID=
S1914_PLAYER_ID=
S1914_SITE_USER_ID=
S1914_USER_AUTH=
S1914_TSTAMP=
S1914_RIGHTS=chat
S1914_ADMIN_LEVEL=0

# Optional — usually not needed for game actions
S1914_COOKIE=

# NVIDIA NIM (OpenAI-compatible): https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MAX_TOKENS=2048
# Use quality model for every seat. Default = fast; set to 1 for @War quality path.
CABINET_QUALITY=0

# Telegram war room (owner-only /approve)
TELEGRAM_BOT_TOKEN=
# Prefer a Telegram *Forum* group (Topics ON). Then /topics setup in chat.
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
TELEGRAM_QUIET_APPROVE=0
# Sensors / LLM / /war /diplo locked to TELEGRAM_USER_ID (set 0 to allow the whole group)
TELEGRAM_OWNER_ONLY_SENSORS=1

# Browser WebSocket bridge
CABINET_WS_PORT=8765
CABINET_WS_HOST=127.0.0.1
# Shared secret for s1914.connectCabinetBridge(url, token). Auto-generated at boot if empty.
CABINET_BRIDGE_TOKEN=
CABINET_DATA_DIR=data/cabinet
# Match memory lives under data/cabinet/games/{gameId}/ (auto on bridge hello)

# HTTP API for MCP / external agents (starts with npm run cabinet)
CABINET_API_PORT=8766
# Defaults to CABINET_BRIDGE_TOKEN if empty
CABINET_API_TOKEN=
# Allow moveArmy/constructBuilding via MCP (default off — read + cabinet_ask only)
CABINET_MCP_WRITES=0
# Stdio MCP: npm run mcp  (points at CABINET_API_URL)
CABINET_API_URL=http://127.0.0.1:8766
CABINET_MCP_TOKEN=

# War Minister watch (deterministic, no NVIDIA on tick)
WAR_WATCH=1
WAR_WATCH_MS=300000
# Optional: log reinforce candidates only (never auto-enters enemy hex)
WAR_AUTO_REINFORCE=0

# Financial Command Center
FINANCE_WATCH=1
FINANCE_WATCH_MS=120000
FINANCE_API_PORT=8787
